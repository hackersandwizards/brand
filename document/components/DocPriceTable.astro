---
// A price table on the base's ruled table: each row an item in bold with an optional muted detail
// line, then its cells; a column marked num holds figures, right-aligned in tabular digits.
// `sums` marks every row a sum, as a rate card's rates: the teal tint on each row, the figure in
// teal in the h4 role, the money colour of Price.astro (blind round 4, rate card 89.4 against 76.7).
// A price below list is a cell { list, offer }: the list price struck in red over the offer in
// green. `total` closes the table on DocTotalRow; `foot` rows follow it muted, such as VAT.
import DocTotalRow from "./DocTotalRow.astro";

type Cell = string | { list: string; offer: string };
interface Foot {
  label: string;
  figure: string;
}
interface Column {
  label: string;
  width?: string;
  num?: boolean;
}
interface Row {
  item: string;
  detail?: string;
  cells: Cell[];
}
interface Props {
  columns: Column[];
  rows: Row[];
  sums?: boolean;
  total?: Foot;
  foot?: Foot[];
}
const { columns, rows, sums = false, total, foot = [] } = Astro.props;
const span = columns.length - 1;
---

<table class:list={{ sums }}>
  <thead>
    <tr>
      {columns.map((c) => (
        <th class:list={{ num: c.num }} style={c.width ? `width: ${c.width}` : undefined}>
          {c.label}
        </th>
      ))}
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <td>
          <strong>{row.item}</strong>
          {row.detail && <span class="detail">{row.detail}</span>}
        </td>
        {row.cells.map((cell, i) => (
          <td class:list={{ num: columns[i + 1]?.num }}>
            {typeof cell === "string" ? (
              cell
            ) : (
              <>
                <span class="strike">{cell.list}</span>
                <br />
                <span class="offer">{cell.offer}</span>
              </>
            )}
          </td>
        ))}
      </tr>
    ))}
    {total && <DocTotalRow label={total.label} span={span} figures={[total.figure]} />}
    {foot.map((row) => (
      <tr class="foot">
        <td colspan={span}>{row.label}</td>
        <td class="num">{row.figure}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  /* Tabular figures only in a figure column: Inter's tabular set widens the hyphen in prose. */
  .num {
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .detail {
    display: block;
    margin-top: 1pt;
    color: var(--muted);
  }

  .strike {
    color: var(--red);
    text-decoration: line-through;
  }

  .offer {
    font-weight: 600;
    color: var(--green-dark);
  }

  .foot td {
    padding-top: 1.6mm;
    padding-bottom: 1.6mm;
    border-bottom: 0;
    font: var(--role-small);
    color: var(--muted);
  }

  .sums td {
    background: var(--teal-soft);
  }

  .sums td:first-child {
    padding-left: 5pt;
  }

  .sums td.num {
    font: var(--role-h4);
    letter-spacing: var(--type-h4-tracking);
    font-variant-numeric: tabular-nums;
    color: var(--teal);
  }
</style>
