---
// The training certificate: a fixed one-page layout on the document base, no page margin, counter,
// body padding or paragraph spacing. Content too long for the page takes the fit steps of the
// script below; what still runs over prints a second page, which the renderer refuses. Names stay
// in Inter: only Inter carries latin-ext (Ł, ř), at 400 and 600. The generator in
// .claude/skills/certificates/generator/ writes these props.
import lockupSvg from "../../logos/lockup.svg?raw";

interface Signer {
  name: string;
  /** The English title; the German certificate names the role itself. */
  title: string;
  /** A data URI; empty leaves room for a signature by hand. */
  image: string;
}
interface Props {
  lang: "de" | "en";
  title: string;
  attendeeName: string;
  attendeeCompany?: string;
  trainingTitle: string;
  trainingSubtitle?: string;
  date: string;
  location?: string;
  remote?: boolean;
  durationHours?: string;
  topics: string[];
  signers: Signer[];
  credentialId?: string;
  verificationUrl?: string;
  qrCodeUri?: string;
  linkedinUrl?: string;
}
const p = Astro.props;
// A data URI, not a file:// one, which would print at its full source size.
const lockup = `data:image/svg+xml;base64,${Buffer.from(lockupSvg).toString("base64")}`;
const de = p.lang === "de";
const place = p.remote ? " (Remote)" : p.location ? ` in ${p.location}` : "";
const hours = p.durationHours ? `, ${p.durationHours} ${de ? "Stunden" : "hours"}` : "";
const details = `${de ? "am" : "on"} ${p.date}${place}${hours}.`;
const topicClass = [
  "topics",
  `topics-count-${p.topics.length}`,
  p.topics.length > 8 && "topics-compact",
  p.topics.length > 12 && "topics-columns",
];
---

<style is:inline>
  @page {
    margin: 0;
    @bottom-right {
      content: none;
    }
  }
  body {
    padding: 0;
  }
</style>
<div class="certificate">
  <div class="header">
    <img src={lockup} alt="hackers&wizards" class="logo" />
  </div>
  <div class="title">
    <h1>{de ? "Abschlusszertifikat" : "Certificate of Completion"}</h1>
  </div>
  <div class="body-text">
    <p class="preamble">{de ? "Hiermit wird bestätigt, dass" : "This is to certify that"}</p>
    <p class="attendee-name">
      {p.attendeeName
        .split(/\s+/)
        .filter(Boolean)
        .map((part) => (
          <>
            <span>{part}</span>{" "}
          </>
        ))}
    </p>
    {p.attendeeCompany && <p class="attendee-company">{p.attendeeCompany}</p>}
    <p class="attended">
      {de ? "erfolgreich teilgenommen hat an dem" : "has successfully attended the"}
    </p>
    <p class="training-title">{p.trainingTitle}</p>
    {p.trainingSubtitle && <p class="training-subtitle">{p.trainingSubtitle}</p>}
    <p class="details">{details}</p>
  </div>
  {p.topics.length > 0 && (
    <div class:list={topicClass}>
      <p class="eyebrow">{de ? "Behandelte Themen" : "Topics covered"}</p>
      <ul>
        {p.topics.map((topic) => (
          <li>{topic}</li>
        ))}
      </ul>
    </div>
  )}
  <div class="signatures">
    {p.signers.map((signer) => (
      <div class="signature-block">
        {signer.image ? (
          <img src={signer.image} alt={signer.name} class="signature-image" />
        ) : (
          <div class="signature-placeholder" />
        )}
        <div class="signature-line" />
        <p class="signer-name">{signer.name}</p>
        <p class="signer-title">{de ? "Mitgründer, hackers&wizards" : signer.title}</p>
      </div>
    ))}
  </div>
  <div class="footer">
    {p.credentialId && (
      <div class="verification">
        {p.qrCodeUri && (
          <a href={p.verificationUrl}>
            <img src={p.qrCodeUri} alt="Certificate verification QR code" class="qr-code" />
          </a>
        )}
        <div class="verification-text">
          <p class="footer-cta">
            {de
              ? "Zertifikat verifizieren und zum LinkedIn-Profil hinzufügen"
              : "Verify this certificate and add it to your LinkedIn profile"}
            <span>
              {de
                ? "Scannen: verifizieren & zu LinkedIn hinzufügen"
                : "Scan to verify & add to LinkedIn"}
            </span>
          </p>
          {p.linkedinUrl && (
            <a class="linkedin-link" href={p.linkedinUrl}>
              {de ? "Zum LinkedIn-Profil hinzufügen" : "Add to LinkedIn profile"}
            </a>
          )}
          <p class="footer-url">
            <a href={p.verificationUrl}>{p.verificationUrl}</a>
          </p>
          <p class="footer-credential">Credential ID: {p.credentialId}</p>
        </div>
      </div>
    )}
    <p class="footer-contact">
      {de ? "Ausgestellt von" : "Issued by"} hackers&amp;wizards GmbH · Osterstraße 95, 20259
      Hamburg · <a href="https://hackersandwizards.dev">hackersandwizards.dev</a>
    </p>
  </div>
</div>
<script is:inline>
  // The fit: a certificate whose content runs past its page takes the steps below in order until
  // it fits. Each is kept only where it shortens the page; the name steps apply to a name on two
  // or more lines; once it fits, each earlier step the page holds without is undone. Content that
  // still does not fit drops the fixed height, so it runs onto a second page, never clipped, and
  // the renderer's one-page check fails. Runs once the faces are ready: measured before, a page
  // fits too few steps (measured).
  (() => {
    const cert = document.currentScript.previousElementSibling;
    const steps = [
      ["fit-tight"],
      ["fit-columns", "fit-wide"],
      ["fit-name", "name"],
      ["fit-gaps"],
      ["fit-signature"],
      ["fit-name-small", "name"],
      ["fit-logo"],
      ["fit-topics"],
    ];
    const all = steps.flat().filter((c) => c.startsWith("fit-"));
    const over = () => {
      const box = cert.getBoundingClientRect();
      let bottom = 0;
      for (const el of cert.querySelectorAll("*"))
        bottom = Math.max(bottom, el.getBoundingClientRect().bottom);
      return bottom - (box.bottom - parseFloat(getComputedStyle(cert).paddingBottom));
    };
    const fit = () => {
      cert.classList.remove(...all, "certificate-overflow");
      let left = over();
      for (const step of steps) {
        if (left <= 0.5) break;
        const name = cert.querySelector(".attendee-name");
        const lines = name.offsetHeight / parseFloat(getComputedStyle(name).lineHeight);
        if (step[1] === "name" && lines < 1.5) continue;
        // Of alternatives, the one that shortens most; none where neither does.
        let best = null;
        for (const option of step.filter((c) => c.startsWith("fit-"))) {
          cert.classList.add(option);
          const after = over();
          cert.classList.remove(option);
          if (after < left) [best, left] = [option, after];
        }
        if (best) cert.classList.add(best);
      }
      if (left > 0.5) return cert.classList.add("certificate-overflow");
      // A late step can free more than was missing: give back each earlier one the page still holds.
      const kept = all.filter((c) => cert.classList.contains(c));
      for (const step of kept.slice(0, -1).reverse()) {
        cert.classList.remove(step);
        if (over() > 0.5) cert.classList.add(step);
      }
    };
    document.fonts.ready.then(fit);
  })();
</script>

<style>
  p {
    margin: 0;
  }

  /* One rhythm with the verifier's certificate page: --cert-tight inside a group of lines (a
     phrase and the name or course it introduces, label and list), --cert-related between the
     groups of the statement, --cert-section between sections. The name is the focal point, then
     the title in teal and the course in purple; the phrases between them share the lead role. */
  .certificate {
    --cert-tight: 3pt;
    --cert-related: 12pt;
    --cert-section: 24pt;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 210mm;
    height: 297mm;
    padding: 16mm 25mm 14mm;
    text-align: center;
  }

  .certificate::before,
  .certificate::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    background: var(--gradient);
  }

  .certificate::before {
    top: 0;
    height: 5mm;
  }

  .certificate::after {
    bottom: 0;
    height: 2mm;
  }

  .logo {
    height: 16mm;
    margin-bottom: var(--cert-section);
  }

  .title {
    margin-bottom: var(--cert-related);
  }

  .title h1 {
    color: var(--teal);
  }

  .preamble,
  .attended,
  .details {
    font: var(--role-lead);
    color: var(--muted);
  }

  /* The one size outside the print roles: display's 26pt read too small for a name. A name too
     long for one line breaks into balanced lines, only between its words, so a hyphenated surname
     stays whole. */
  .attendee-name {
    margin-top: var(--cert-tight);
    font: 600 calc(var(--type-display-size) * 1.75) / 1.15 var(--type-lead-family);
    letter-spacing: var(--type-h1-tracking);
    text-wrap: balance;
    color: var(--ink);
  }

  .attendee-name span {
    white-space: nowrap;
  }

  .attendee-company {
    margin-top: var(--cert-tight);
    font: var(--role-small);
    color: var(--muted);
  }

  .attended {
    margin-top: var(--cert-related);
  }

  /* Title and subtitle are one course name in one size, split where the generator splits it. */
  .training-title {
    margin-top: var(--cert-tight);
  }

  .training-title,
  .training-subtitle {
    font: var(--role-h2);
    letter-spacing: var(--type-h2-tracking);
    color: var(--purple);
  }

  .details {
    margin-top: var(--cert-tight);
  }

  .topics {
    flex: 1 1 auto;
    width: 100%;
    max-width: 130mm;
    margin-top: var(--cert-section);
    text-align: left;
  }

  /* The verifier page's label caps. */
  .eyebrow {
    display: block;
    margin-bottom: calc(2 * var(--cert-tight));
    font: var(--role-label);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--teal-dark);
  }

  .topics li {
    font: var(--role-small);
    color: var(--muted);
  }

  .topics-compact {
    max-width: 145mm;
  }

  .topics-compact li {
    padding-top: 0.3mm;
    padding-bottom: 0.3mm;
  }

  .topics-columns {
    max-width: 160mm;
  }

  .topics-columns ul {
    columns: 2;
    column-gap: 10mm;
  }

  .topics-columns li {
    break-inside: avoid;
  }

  /* Both founders sign, at a size that reads as a signature. */
  .signatures {
    display: flex;
    justify-content: space-around;
    gap: 16mm;
    width: 100%;
    margin: var(--cert-section) 0;
  }

  .signature-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 72mm;
  }

  .signature-image,
  .signature-placeholder {
    height: 22mm;
    margin-bottom: var(--cert-tight);
  }

  .signature-image {
    max-width: 70mm;
    object-fit: contain;
  }

  .signature-line {
    width: 66mm;
    margin-bottom: var(--cert-tight);
    border-top: var(--print-rule) solid var(--ink);
  }

  .signer-name {
    font: var(--role-small);
    font-weight: 600;
  }

  .signer-title {
    font: var(--role-small);
    color: var(--muted);
  }

  .verification {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--cert-related);
    margin-bottom: var(--cert-related);
    text-align: left;
  }

  .qr-code {
    width: 26mm;
    height: 26mm;
  }

  .footer-cta {
    font: var(--role-small);
    font-weight: 600;
  }

  .footer-cta span {
    display: block;
    font-weight: 400;
    color: var(--muted);
  }

  .footer-url,
  .footer-credential {
    margin-top: var(--cert-tight);
    font: var(--role-code);
    white-space: nowrap;
    color: var(--muted);
  }

  /* Read on a phone, never printed: the one tap that puts the credential on a LinkedIn profile. */
  .linkedin-link {
    display: inline-block;
    margin: calc(2 * var(--cert-tight)) 0 var(--cert-tight);
    padding: 2.8mm 7mm;
    font: var(--role-lead);
    font-weight: 600;
    border-radius: var(--radius);
    background: var(--teal);
    color: var(--color-white);
    text-decoration: none;
  }

  .footer-contact {
    font: var(--role-small);
    color: var(--muted);
  }

  .footer-contact a {
    color: inherit;
    text-decoration: none;
  }

  /* The fit steps the script above takes, in its order. */
  .fit-tight .topics li {
    padding-top: 0;
    padding-bottom: 0;
  }

  .fit-columns .topics,
  .fit-wide .topics {
    max-width: 160mm;
  }

  .fit-columns .topics ul {
    columns: 2;
    column-gap: 10mm;
  }

  .fit-columns .topics li {
    break-inside: avoid;
  }

  .fit-name .attendee-name {
    font-size: calc(var(--type-display-size) * 1.5);
  }

  .fit-gaps {
    --cert-section: 16pt;
  }

  .fit-signature :is(.signature-image, .signature-placeholder) {
    height: 16mm;
  }

  .fit-name-small .attendee-name {
    font-size: calc(var(--type-display-size) * 1.25);
  }

  .fit-logo .logo {
    height: 12mm;
  }

  /* The label role's size and leading in the small role's face: the topics stay in Inter. */
  .fit-topics .topics li {
    font-size: var(--type-label-size);
    line-height: var(--type-label-line-height);
  }

  .certificate-overflow {
    height: auto;
  }
</style>
