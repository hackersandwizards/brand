---
// The outcome callout: InShort.astro's accent rule on the left of a tint with the brand corner on
// all four corners, here in purple, which marks the result and nothing else (EventRow.astro's next
// event; the heading 4.9:1 on the tint). Its text is set in weight 500.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="callout">
  <h3>{title}</h3>
  <slot />
</div>

<style>
  .callout {
    margin: 8pt 0;
    padding: var(--print-card-pad);
    border-left: var(--print-rule-accent) solid var(--purple);
    border-radius: var(--radius);
    background: var(--purple-soft);
    break-inside: avoid;
  }

  .callout > :global(*) {
    font-weight: 500;
  }

  h3 {
    margin-top: 0;
    color: var(--purple);
  }

  .callout > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
