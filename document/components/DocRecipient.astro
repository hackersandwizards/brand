---
// The recipient card, Card.astro's tint surface: a label in caps, the company bold, then the
// person and the address, one per line.
interface Props {
  label: string;
  company: string;
  lines: string[];
  /** A second group under the address, such as the contact person. */
  contact?: { label: string; name: string };
}
const { label, company, lines, contact } = Astro.props;
---

<div class="prepared">
  <span class="label">{label}</span>
  <strong>{company}</strong>
  {lines.map((line) => (
    <>
      <br />
      {line}
    </>
  ))}
  {contact && (
    <>
      <span class="label second">{contact.label}</span>
      {contact.name}
    </>
  )}
</div>

<style>
  .prepared {
    align-self: start;
    padding: var(--print-card-pad);
    border: var(--print-rule) solid var(--teal-line);
    border-radius: var(--radius);
    background: var(--teal-soft);
    font: var(--role-small);
    break-inside: avoid;
  }

  /* typography.css .label-caps, in ink as the footer's group headings set it. */
  .label {
    display: block;
    margin-bottom: 2pt;
    font: var(--role-label);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-case);
    color: var(--ink);
  }

  .second {
    margin-top: 7pt;
  }

  /* The contact label is the card's last element, its name a bare text after it: no gap under it. */
  .prepared > :last-child {
    margin-bottom: 0;
  }
</style>
