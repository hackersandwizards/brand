---
// The document header, the twin of the website's Nav.astro: a bar in the page tint across the
// paper, the gradient strip on top, a rule under it, the lockup left and the document tag right.
// The lockup is this package's own, inlined as a data URI, so the header renders in any app.
import lockupSvg from "../../logos/lockup.svg?raw";

interface Props {
  /** The document kind in the tag, e.g. "Honorarsätze". */
  kind: string;
  /** Adds "GmbH" and the imprint under the wordmark, for documents naming the legal entity. */
  legal?: boolean;
  /** The imprint under a legal wordmark; a Markdown contract names the parties in its body. */
  imprint?: boolean;
  /** Lines under the tag, such as the date and the validity. */
  meta?: string[];
  /** The imprint's language. */
  lang?: "de" | "en";
}
const { kind, legal = false, imprint = legal, meta = [], lang = "de" } = Astro.props;
const imprintLines = {
  de: [
    "Geschäftsführer: Benedikt Stemmildt & Stefan Munz",
    "Osterstraße 95, 20259 Hamburg",
    "AG Hamburg HRB 198840, USt-IdNr. DE463065921",
  ],
  en: [
    "Managing Directors: Benedikt Stemmildt & Stefan Munz",
    "Osterstraße 95, 20259 Hamburg, Germany",
    "AG Hamburg HRB 198840, VAT ID DE463065921",
  ],
}[lang];
// Base64 rather than Vite's URL-encoded SVG inline.
const lockup = `data:image/svg+xml;base64,${Buffer.from(lockupSvg).toString("base64")}`;
---

<header class="doc-header">
  <div class="brand">
    <div class="brand-name">
      <img src={lockup} alt="hackers&wizards" />
      {legal && <span class="legal">GmbH</span>}
    </div>
      {legal && imprint && (
        <div class="company-meta">
          {imprintLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
          <a href="mailto:summon@hackersandwizards.dev">summon@hackersandwizards.dev</a>
        </div>
      )}
  </div>
  <div class="doc-meta">
    <span class="doc-tag">{kind}</span>
    {meta.map((line) => (
      <>
        <br />
        {line}
      </>
    ))}
  </div>
</header>

<style>
  .doc-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8mm;
    min-height: calc(var(--print-row) + var(--print-strip));
    margin-bottom: 8mm;
    padding: calc(var(--print-strip) + 8pt) 0 8pt;
  }

  .doc-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 calc(-1 * var(--side));
    border-top: var(--print-strip) solid transparent;
    border-bottom: var(--print-rule) solid var(--line);
    background:
      var(--gradient) top / 100% var(--print-strip) no-repeat border-box,
      var(--color-bg) padding-box;
  }

  /* The lockup at the print logo's height, the header row's mark, which sets its wordmark at 952 of
     the lockup's 1489 units, 1.25 times the print wordmark: at the print wordmark's own height the
     letters were hard to read at 80% zoom. The imprint lines sit under it. The box is the wizard's,
     whose centre lies 7.8% of the box (--logo-wizard-lift) above the wordmark's centre line, so
     "GmbH" moves down by that share to centre on the letters. */
  .brand {
    --lockup-height: var(--print-logo);
    display: block;
  }

  .brand-name {
    display: flex;
    align-items: center;
    gap: var(--print-wordmark-gap);
    font: var(--role-h4);
    line-height: 1;
  }

  .brand-name img {
    width: auto;
    height: var(--lockup-height);
    flex: none;
    translate: none;
  }

  .legal {
    color: var(--ink);
    translate: 0 calc(var(--lockup-height) * 0.078);
  }

  .company-meta {
    margin-top: 1.5pt;
    font: var(--role-small);
    color: var(--muted);
  }

  .doc-meta {
    max-width: 70mm;
    font: var(--role-small);
    text-align: right;
    color: var(--muted);
  }

  .doc-header a {
    color: inherit;
    text-decoration: none;
  }

  /* The website's category pill (TrainingList.astro .tl-chip): in print the 40% teal tint,
     teal-light, under ink, weight 500. A filled CTA shape was dropped: blind reviewers read it as a button. */
  .doc-tag {
    display: inline-block;
    margin-bottom: 3pt;
    padding: var(--print-chip-pad);
    border-radius: var(--radius-pill);
    background: var(--color-teal-light);
    font: var(--role-small);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink);
  }
</style>
