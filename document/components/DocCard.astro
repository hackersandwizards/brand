---
// Card.astro: the brand corner, a hairline border, white, the card padding. `tint` is its
// emphasised surface; `small` sets it in the small role, `dense` too with tighter gaps, for terms.
// `meta` is one muted line under the title, for a format and a size.
interface Props {
  title?: string;
  meta?: string;
  tint?: boolean;
  small?: boolean;
  dense?: boolean;
}
const { title, meta, tint = false, small = false, dense = false } = Astro.props;
---

<div class:list={["card", { tint, small, dense }]}>
  {title && <h3>{title}</h3>}
  {meta && <p class="meta">{meta}</p>}
  <slot />
</div>

<style>
  .card {
    margin: 6pt 0;
    padding: var(--print-card-pad);
    border: var(--print-rule) solid var(--line);
    border-radius: var(--radius);
    background: white;
    break-inside: avoid;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .tint {
    border-color: var(--teal-line);
    background: var(--teal-soft);
  }

  h3 {
    margin: 0 0 1mm;
  }

  .small,
  .dense {
    font: var(--role-small);
  }

  .meta {
    margin-bottom: 2mm;
    font: var(--role-small);
    font-weight: 500;
    color: var(--muted);
  }

  .dense h3 {
    margin-bottom: 1.5mm;
  }

  .dense :global(p) {
    margin: 0 0 1mm;
  }

  .card > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
