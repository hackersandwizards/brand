{
  "mutate": [
    "scan/{colours,components,copies}.ts",
    "elements/{code,list-filter}.ts",
    "expert/components/space-nav.ts",
    "scripts/tokens.ts",
    "applications/mail-signature/fill.ts"
  ],
  "testRunner": "vitest",
  "plugins": ["./scripts/stryker-vitest.mjs"],
  "vitest": {
    "configFile": "vitest.config.ts",
    "pool": "forks",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": ".stryker-reports/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "concurrency": 2,
  "ignoreStatic": true,
  "ignorePatterns": [".*", "/dist"],
  "incremental": true,
  "incrementalFile": ".stryker-reports/incremental.json"
}
