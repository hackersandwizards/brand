#!/bin/sh
# bun install --frozen-lockfile under the lock the gate and a build hold (node_modules/.check.lock),
# for the post-merge and post-checkout hooks, the SessionStart hook and the MCP server's start.
# Silent when it installs; a skip or a failure goes to stderr with what to run. Never to stdout,
# which is an MCP server's protocol channel.
# check-lock beside this script: git may run a hook from another worktree than the one it installs.
hooks=$(CDPATH="" cd -- "$(dirname -- "$0")" && pwd) || exit 1
cd "$(git rev-parse --show-toplevel)" || exit 1
log=$(mktemp) || exit 1
trap 'rm -f "$log"' EXIT
# check-lock is the skeleton's own copy, so a first install, before node_modules holds the package,
# takes the lock as every later one does. Without waiting behind a gate or a build, which a merge or
# a session start would otherwise do for minutes: a gate installs as its first step; after a build,
# the next gate or session start installs. Another install holding the lock is waited for, as
# check-lock does for its own command. SCAFFOLDING_LOCKED is cleared: a git command a gate runs in
# its own checkout would otherwise install at once, beside the gate's other steps.
SCAFFOLDING_LOCKED= CHECK_LOCK_WAIT_MS=0 bun --no-env-file "$hooks/check-lock.ts" bun install --frozen-lockfile </dev/null >"$log" 2>&1
status=$?
if [ "$status" -ne 0 ]; then
  cat "$log" >&2
  echo "[install] bun install --frozen-lockfile did not run or failed (above): run it in $(pwd -P) before your gate" >&2
fi
exit "$status"
