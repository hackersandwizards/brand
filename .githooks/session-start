#!/bin/sh
# The SessionStart hook: fetches main within 20 s (SCAFFOLDING_FETCH_WAIT_S) and says how far
# behind it the checkout is, then installs. Its stdout is the session's context, so it prints only
# what the session must act on. It moves no branch in a checkout other sessions share: a
# fast-forward succeeds with another session's uncommitted file in the tree and moves HEAD under
# it. The session merges per git.md. A cloud session's checkout is its own, so there it switches
# to main and fast-forwards. check-lock stops the install after CHECK_LOCK_RUN_S seconds, as in
# post-checkout: a slow install or lock held up every session start.
exec 2>&1
cd "$(git rev-parse --show-toplevel)" || exit 0
wait=${SCAFFOLDING_FETCH_WAIT_S:-20}
# A bound that is no whole number of seconds, or 0, which would end the fetch at once, is the default.
case $wait in *[!0-9]*) wait=20 ;; *[1-9]*) ;; *) wait=20 ;; esac
# Into origin/main by name: a clone of one other branch has no refspec that updates it.
ref=+refs/heads/main:refs/remotes/origin/main
# Bounded by the clock: an SSH remote waits for a person to approve the key, and nothing in ssh or
# git ends that wait. The fetch runs in a process group of its own (detached), so the kill ends ssh
# with git; dash's `set -m` makes none without a terminal, so bun keeps the time. Without bun,
# which the install below needs too, the fetch runs unbounded.
if ! command -v bun >/dev/null; then
  GIT_TERMINAL_PROMPT=0 git fetch -q origin "$ref" >/dev/null 2>&1
else
  bun --no-env-file -e '
  const { spawn } = require("node:child_process");
  const git = spawn("git", ["fetch", "-q", "origin", process.argv[2]], {
    detached: true,
    stdio: "ignore",
    env: { ...process.env, GIT_TERMINAL_PROMPT: "0" },
  });
  // setTimeout runs a delay past 2^31 - 1 ms at once.
  const timer = setTimeout(() => {
    try {
      process.kill(-git.pid, "SIGTERM");
    } catch {}
    process.exit(124);
  }, Math.min(Number(process.argv[1]) * 1000, 2 ** 31 - 1));
  git.on("exit", (code) => {
    clearTimeout(timer);
    process.exit(code ?? 1);
  });
' "$wait" "$ref" 2>/dev/null
fi
fetched=$?
if [ "$fetched" -eq 0 ]; then
  if [ "$CLAUDE_CODE_REMOTE" = true ]; then
    # A clone of one other branch has no fetch refspec for main, without which `git switch main`
    # neither starts main from origin/main nor sets it as main's upstream. Replaced, not added: a
    # start after a failed switch added it again.
    { git show-ref -q --verify refs/heads/main ||
      git config --replace-all remote.origin.fetch "$ref" '^[+]?refs/heads/main:'; } &&
      git switch -q main && git merge --ff-only -q origin/main ||
      echo "main not switched to or origin/main not merged: fix it per git.md"
  else
    behind=$(git rev-list --count HEAD..origin/main 2>/dev/null)
    [ "${behind:-0}" -eq 0 ] ||
      echo "origin/main is $behind commits ahead of HEAD: merge it per git.md before work"
  fi
elif [ "$fetched" -eq 124 ]; then
  echo "origin main not fetched within $wait s: fetch and merge per git.md before work"
else
  echo "git fetch origin main failed: fetch and merge per git.md before work"
fi
CHECK_LOCK_RUN_S=${CHECK_LOCK_RUN_S:-60} .githooks/install || true
