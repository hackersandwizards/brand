{
  "name": "@hackersandwizards/brand",
  "version": "1.1.0",
  "private": true,
  "description": "The hackers&wizards brand: tokens, print layer, fonts, logos, the expert UI layer and its components, the press photos, the verbal identity (claim, mission, vision, values, terms, retired slogans), the LinkedIn post renderers with their sketch prompt, the mail signature template, and the colour, copy, component, list-marker and element checks a consumer runs in its gate, the list marker rule and the shared elements.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.root.css": "./generated/tokens.root.css",
    "./tokens.json": "./generated/tokens.json",
    "./tokens": "./generated/tokens.ts",
    "./tokens.py": "./generated/tokens.py",
    "./code-theme.json": "./generated/code-theme.json",
    "./print.css": "./tokens/print.css",
    "./fonts.css": "./tokens/fonts.css",
    "./night.css": "./tokens/night.css",
    "./stage.css": "./tokens/stage.css",
    "./document.css": "./tokens/document.css",
    "./marker.css": "./tokens/marker.css",
    "./fonts/*": "./tokens/fonts/*",
    "./expert.css": "./expert/expert.css",
    "./header.css": "./expert/header.css",
    "./select.css": "./expert/select.css",
    "./disclosure.css": "./expert/disclosure.css",
    "./elements.css": "./elements/elements.css",
    "./elements/*": "./elements/*",
    "./expert/components/*": "./expert/components/*",
    "./logos/*": "./logos/*",
    "./clients/*": "./clients/*",
    "./press/*": "./press/*",
    "./verbal.json": "./verbal/verbal.json",
    "./mail-signature/*": "./applications/mail-signature/*"
  },
  "bin": {
    "brand-colours": "scan/colours.ts",
    "brand-copies": "scan/copies.ts",
    "brand-scan": "scan/components.ts",
    "brand-markers": "scan/markers.ts",
    "brand-elements": "scan/elements.ts",
    "brand-linkedin-frame": "applications/linkedin-visuals/frame.ts",
    "brand-linkedin-terminal": "applications/linkedin-visuals/terminal.ts",
    "brand-linkedin-sketch-prompt": "applications/linkedin-visuals/sketch-prompt.ts",
    "brand-slide-sketch-prompt": "applications/slide-visuals/sketch-prompt.ts",
    "brand-mail-signature": "applications/mail-signature/cli.ts"
  },
  "files": [
    "tokens",
    "generated",
    "expert",
    "elements",
    "logos/*.svg",
    "logos/lockup*.png",
    "logos/wordmark*.png",
    "logos/type-logo-*.png",
    "logos/avatar-*.png",
    "logos/favicon.ico",
    "logos/logos.json",
    "logos/apple-touch-icon.png",
    "logos/icon-*.png",
    "clients",
    "press",
    "verbal",
    "applications/linkedin-visuals/*.ts",
    "applications/linkedin-visuals/*.txt",
    "applications/slide-visuals/*.ts",
    "applications/slide-visuals/*.txt",
    "applications/mail-signature",
    "scan/*.ts",
    "manifest.json"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "scaffolding check",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "tokens": "bun scripts/tokens.ts",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "bun --bun astro build --root catalog",
    "test": "bun test --path-ignore-patterns='test/catalog/**' --path-ignore-patterns='dist/**'",
    "check:catalog": "bun test ./test/catalog/",
    "check:tokens": "bun scripts/tokens.ts --check",
    "check:staged": "check-staged"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.0.0",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v1.0.0",
    "@types/bun": "1.4.4",
    "astro": "7.4.4",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "dependencies": {
    "puppeteer-core": "25.16.0"
  },
  "admin": {
    "designSystem": "https://hackersandwizards.github.io/brand/",
    "products": [
      {
        "label": "Assets",
        "href": "https://hackersandwizards.github.io/brand/#logos"
      }
    ]
  },
  "scaffolding": {
    "allow": [],
    "test": "test",
    "uniqueNames": [
      "GET",
      "getStaticPaths"
    ],
    "check": [
      "check:catalog",
      "check:tokens"
    ]
  }
}
