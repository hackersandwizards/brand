{
  "name": "@hackersandwizards/brand",
  "version": "0.24.9",
  "private": true,
  "description": "The hackers&wizards brand: tokens, print layer, fonts, logos, the expert UI layer and its components, the press photos, the LinkedIn post renderers with their sketch prompt, the mail signature template, and the colour, copy, component and list-marker checks a consumer runs in its gate, and the list marker rule.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.root.css": "./generated/tokens.root.css",
    "./tokens.json": "./generated/tokens.json",
    "./tokens": "./generated/tokens.ts",
    "./tokens.py": "./generated/tokens.py",
    "./code-theme.json": "./generated/code-theme.json",
    "./print.css": "./tokens/print.css",
    "./marker.css": "./tokens/marker.css",
    "./fonts/*": "./tokens/fonts/*",
    "./expert.css": "./expert/expert.css",
    "./header.css": "./expert/header.css",
    "./select.css": "./expert/select.css",
    "./expert/components/*": "./expert/components/*",
    "./logos/*": "./logos/*",
    "./clients/*": "./clients/*",
    "./press/*": "./press/*",
    "./mail-signature/*": "./applications/mail-signature/*"
  },
  "bin": {
    "brand-colours": "scan/colours.ts",
    "brand-copies": "scan/copies.ts",
    "brand-scan": "scan/components.ts",
    "brand-markers": "scan/markers.ts",
    "brand-linkedin-frame": "applications/linkedin-visuals/frame.ts",
    "brand-linkedin-terminal": "applications/linkedin-visuals/terminal.ts",
    "brand-linkedin-sketch-prompt": "applications/linkedin-visuals/sketch-prompt.ts",
    "brand-slide-sketch-prompt": "applications/slide-visuals/sketch-prompt.ts",
    "brand-mail-signature": "applications/mail-signature/cli.ts"
  },
  "files": [
    "tokens",
    "generated",
    "expert",
    "logos/*.svg",
    "logos/lockup*.png",
    "logos/wordmark*.png",
    "logos/type-logo-*.png",
    "logos/avatar-*.png",
    "logos/favicon.ico",
    "logos/apple-touch-icon.png",
    "logos/icon-*.png",
    "clients",
    "press",
    "applications/linkedin-visuals/*.ts",
    "applications/linkedin-visuals/*.txt",
    "applications/slide-visuals/*.ts",
    "applications/slide-visuals/*.txt",
    "applications/mail-signature",
    "scan/*.ts",
    "manifest.json"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun .claude/skills/engineering/check-unique-names.ts && bun test && bun scripts/tokens.ts --check && bun scripts/catalogue.ts --check",
    "lint": "bun --bun eslint --cache --concurrency=auto .",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "tokens": "bun scripts/tokens.ts",
    "catalogue": "bun scripts/catalogue.ts",
    "dev": "bun scripts/serve.ts",
    "check:staged": "bun .claude/skills/engineering/check-staged.ts",
    "lfs:pre-push": "git lfs pre-push"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "astro": "7.4.4",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "puppeteer-core": "25.16.0"
  }
}
