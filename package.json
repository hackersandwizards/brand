{
  "name": "@hackersandwizards/brand",
  "version": "0.9.11",
  "private": true,
  "description": "The hackers&wizards brand: tokens, print layer, fonts, logos, the expert UI layer and its components, the document base, the document components, the press photos, the LinkedIn post renderers and the colour scan a consumer runs in its gate.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.root.css": "./generated/tokens.root.css",
    "./tokens.json": "./generated/tokens.json",
    "./tokens": "./generated/tokens.ts",
    "./tokens.py": "./generated/tokens.py",
    "./print.css": "./tokens/print.css",
    "./fonts/*": "./tokens/fonts/*",
    "./expert.css": "./expert/expert.css",
    "./expert/components/*": "./expert/components/*",
    "./document.css": "./document/document.css",
    "./document/components/*": "./document/components/*",
    "./logos/*": "./logos/*",
    "./clients/*": "./clients/*",
    "./press/*": "./press/*"
  },
  "bin": {
    "brand-colours": "scan/colours.ts"
  },
  "files": [
    "tokens",
    "generated",
    "expert",
    "document/document.css",
    "document/components",
    "logos/*.svg",
    "logos/type-logo-long.png",
    "logos/type-logo-short.png",
    "clients",
    "press",
    "applications/linkedin-visuals/*.ts",
    "scan/colours.ts"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$PWD\" ] && git config core.hooksPath .githooks || true",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun .claude/skills/engineering/check-unique-names.ts && bun test && bun scripts/tokens.ts --check && bun scripts/catalogue.ts --check",
    "lint": "eslint --cache --concurrency=auto .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint --cache --concurrency=auto . --fix && prettier --write .",
    "tokens": "bun scripts/tokens.ts",
    "scan": "bun scripts/scan.ts",
    "drift": "bun scripts/drift.ts",
    "catalogue": "bun scripts/catalogue.ts"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "astro": "7.4.4",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
