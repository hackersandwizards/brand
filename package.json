{
  "name": "@hackersandwizards/brand",
  "version": "2.19.0",
  "private": true,
  "description": "The hackers&wizards brand: tokens, print layer, fonts, logos, the expert UI layer and its components, the press photos, the verbal identity (claim, home headline, mission, vision, values, terms, retired slogans), the LinkedIn post renderers with their sketch prompt, the mail signature template, and the colour, copy, component, list-marker, element and retired-line checks a consumer runs in its gate, the list marker rule and the shared elements.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.root.css": "./generated/tokens.root.css",
    "./tokens.json": "./generated/tokens.json",
    "./tokens": "./generated/tokens.ts",
    "./tokens.py": "./generated/tokens.py",
    "./code-theme.json": "./generated/code-theme.json",
    "./fonts.json": "./generated/fonts.json",
    "./font-faces": "./generated/font-faces.ts",
    "./print.css": "./tokens/print.css",
    "./fonts.css": "./tokens/fonts.css",
    "./static-fonts.css": "./generated/static-fonts.css",
    "./cursor.svg": "./generated/cursor.svg",
    "./copy.js": "./generated/copy.js",
    "./imprint.json": "./verbal/imprint.json",
    "./night.css": "./tokens/night.css",
    "./stage.css": "./tokens/stage.css",
    "./document.css": "./tokens/document.css",
    "./document.flat.css": "./generated/document.css",
    "./marker.css": "./tokens/marker.css",
    "./layers.css": "./tokens/layers.css",
    "./text-base.css": "./tokens/text-base.css",
    "./fonts/*": "./tokens/fonts/*",
    "./expert.css": "./expert/expert.css",
    "./header.css": "./expert/header.css",
    "./catalogs.json": "./expert/catalogs.json",
    "./select.css": "./elements/select.css",
    "./disclosure.css": "./elements/disclosure.css",
    "./app-base.css": "./expert/app-base.css",
    "./elements.css": "./elements/elements.css",
    "./elements.flat.css": "./generated/elements.css",
    "./elements/*": "./elements/*",
    "./expert/components/*": "./expert/components/*",
    "./logos/*": "./logos/*",
    "./press/*": "./press/*",
    "./verbal.json": "./verbal/verbal.json",
    "./mail-signature/*": "./applications/mail-signature/*",
    "./markers": "./scan/markers.ts",
    "./Element.astro": "./catalog/Element.astro",
    "./package.json": "./package.json"
  },
  "bin": {
    "brand-colours": "scan/colours.ts",
    "brand-copies": "scan/copies.ts",
    "brand-scan": "scan/components.ts",
    "brand-markers": "scan/markers.ts",
    "brand-elements": "scan/elements.ts",
    "brand-retired": "scan/retired.ts",
    "brand-linkedin-frame": "applications/linkedin-visuals/frame.ts",
    "brand-linkedin-terminal": "applications/linkedin-visuals/terminal.ts",
    "brand-linkedin-sketch-prompt": "applications/linkedin-visuals/sketch-prompt.ts",
    "brand-slide-sketch-prompt": "applications/slide-visuals/sketch-prompt.ts",
    "brand-mail-signature": "applications/mail-signature/cli.ts"
  },
  "files": [
    "tokens",
    "generated",
    "expert",
    "elements",
    "logos/*.svg",
    "logos/lockup*.png",
    "logos/wordmark*.png",
    "logos/favicon.ico",
    "logos/logos.json",
    "logos/apple-touch-icon.png",
    "logos/icon-*.png",
    "logos/emoji-256.png",
    "press",
    "verbal",
    "applications/linkedin-visuals/*.ts",
    "applications/linkedin-visuals/*.txt",
    "applications/slide-visuals/*.ts",
    "applications/slide-visuals/*.txt",
    "applications/mail-signature",
    "catalog/Element.astro",
    "catalog/ElementScript.astro",
    "catalog/element-demos.ts",
    "scan/*.ts",
    "docs/*.md",
    "manifest.json"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && { git config core.hooksPath .githooks; git -c lfs.fetchexclude= lfs pull --exclude='logos/*.tif'; } || true",
    "check": "scaffolding check",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "tokens": "bun scripts/tokens.ts",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "check-lock bun --bun astro build --root catalog",
    "test": "bun test --timeout ${SCAFFOLDING_TEST_TIMEOUT_MS:-5000} --path-ignore-patterns='test/catalog/**' --path-ignore-patterns='dist/**'",
    "check:catalog": "bun test --timeout ${SCAFFOLDING_TEST_TIMEOUT_MS:-5000} ./test/catalog/",
    "check:tokens": "bun scripts/tokens.ts --check",
    "check:staged": "check-staged"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.27.1",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v5.16.0",
    "@hackersandwizards/testimonials": "git+https://github.com/hackersandwizards/testimonials.git#v3.0.3",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.4.7",
    "astrobook": "0.13.3",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "lightningcss": "1.33.0",
    "lucide-static": "1.70.0",
    "prettier": "3.9.10",
    "satteri": "0.11.7",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "svgo": "4.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "dependencies": {
    "puppeteer-core": "25.17.0"
  },
  "admin": {
    "designSystem": "https://hackersandwizards.github.io/brand/catalog/",
    "products": [
      {
        "label": "Assets",
        "href": "https://hackersandwizards.github.io/brand/#logos"
      }
    ]
  },
  "scaffolding": {
    "allow": [
      {
        "check": "coupling",
        "path": "applications/channel-banners/render.py",
        "reason": "Python reads the testimonials marks at their installed path: it cannot resolve package exports"
      },
      {
        "check": "structure",
        "path": ".claude/settings.json",
        "reason": "The SessionStart hook is Benedikt's own, his decision of 02.11. (a plain bun install, no lock), and an open decision of his covers whether it changes: it stays as he set it rather than the skeleton's"
      }
    ],
    "test": "test",
    "uniqueNames": [
      "GET",
      "getStaticPaths"
    ],
    "check": [
      "check:catalog",
      "check:tokens"
    ]
  }
}
