logos/*.tif filter=lfs diff=lfs merge=lfs -text export-ignore
logos/emoji-logo-short.png filter=lfs diff=lfs merge=lfs -text export-ignore
applications/**/*.png filter=lfs diff=lfs merge=lfs -text export-ignore
applications/**/*.pdf filter=lfs diff=lfs merge=lfs -text export-ignore
applications/**/*.ai filter=lfs diff=lfs merge=lfs -text export-ignore

# A tag install is GitHub's tarball of the tag, built by `git archive`: it leaves out every LFS file
# above and the sources no `exports` target or `bin` reads.
/catalog export-ignore
/docs export-ignore
/scripts export-ignore
/test export-ignore
/applications/* export-ignore
/applications/linkedin-visuals -export-ignore
/applications/slide-visuals -export-ignore
/applications/mail-signature -export-ignore
