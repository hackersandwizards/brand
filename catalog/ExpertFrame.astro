---
// An expert component's story (expert/components) at the apps' dense scale, on the stylesheet an
// expert app compiles (expert.css). `data-story-of` names the component, or the expert class a
// composition shows (form-input in the filter bar).
import "./expert.css";

interface Props {
  component: string;
}
const { component } = Astro.props;
---

<div class="expert-frame" data-hw-scale="dense" data-story-of={component}>
  <slot />
</div>

<style>
  .expert-frame {
    padding: 1.5rem 1rem;
    color: var(--foreground);
  }
</style>
