---
// A shared element's tile on a design-system page, the one brand-elements counts (data-hw-tile,
// data-hw-version): a caption naming its source, brand's version and its entry in brand's
// catalogue, then the sample at one scale, on light or night, with the focus ring turned on. The
// sample is the page's own markup in the default slot, else brand's (element-demos.ts) with the
// behaviour it needs.
//
//   import Element from "@hackersandwizards/brand/Element.astro";
//   <Element name="pill" scale="dense" note="A deal's stage"><span class="hw-pill">Won</span></Element>
import catalogs from "../expert/catalogs.json";
import pkg from "../package.json";
import { DEMOS } from "./element-demos";
import ElementScript from "./ElementScript.astro";

interface Props {
  name: string;
  scale?: "screen" | "dense" | "print" | "stage";
  night?: boolean;
  /** Element settings the surface sets, as a style attribute ("--hw-prose-width: 32rem"). */
  settings?: string;
  /** Where the page uses the element, after the caption. */
  note?: string;
  /** The caption's language, the page's own: German for "de" and its regions, else English. */
  lang?: string;
}

const { name, scale = "screen", night = false, settings, note, lang = "en" } = Astro.props;
const brand = catalogs.find((c) => c.name === "Brand")!;
const entry = brand.portal! + brand.anchors!.element.replace("<element>", name);
const own = Astro.slots.has("default");
if (!own && !(name in DEMOS))
  throw new Error(`Element: "${name}" is no shared element with a brand sample; pass your own`);
const words = /^de\b/.test(lang) ? ["aus brand", "Katalog"] : ["from brand", "catalogue"];
---

<div class="tile" data-hw-tile={name} data-hw-version={pkg.version}>
  <p class="caption">
    {words[0]} v{pkg.version} · <code>hw-{name}</code> ·{" "}
    <a class="hw-link" href={entry}>
      {words[1]}
    </a>
    {note && <span class="note">{note}</span>}
  </p>
  <div
    class="sample hw-focus-ring"
    data-hw-scale={scale}
    data-theme={night ? "dark" : undefined}
    style={settings}
  >
    {own ? <slot /> : <Fragment set:html={DEMOS[name]} />}
  </div>
</div>
{!own && <ElementScript />}

<style>
  .caption {
    margin: 0 0 0.5rem;
    font-size: 0.875em;
  }
  .note {
    display: block;
  }
  .sample {
    padding: 1.5rem;
    background: var(--color-white);
    color: var(--color-ink);
  }
  .sample[data-theme="dark"] {
    background: var(--color-night);
    color: var(--color-night-ink);
  }
  /* A lone box's target keeps its own margins, which hold the box in the line of the rows above. */
  .sample > :global(* + *:where(:not(.hw-check-target))) {
    margin-top: 0.5em;
  }
  .sample :global(:is(p, blockquote, pre)) {
    margin-block: 0;
  }
</style>
