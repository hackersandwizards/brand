---
// The list filter (expert/components/ListFilter.astro) over list rows (ListRow.astro), at one scale,
// on light or night, as an app's or the website's list page renders it. `mode` shows the ways a
// static page keeps its rows under an overview: in a template, listed, or loaded from a source page
// (the dense story); "listed" adds a second facet as choices, "many" gives the topic more labels
// than its budget holds, so it shows as a select beside the search, and "none" passes no facet.
import ListFilter from "../expert/components/ListFilter.astro";
import ListRow from "../expert/components/ListRow.astro";

interface Props {
  scale?: "screen" | "dense";
  night?: boolean;
  mode?: "inert" | "listed" | "source" | "many" | "none";
}

const { scale = "dense", night = false, mode } = Astro.props;
const overview =
  mode && ["inert", "listed", "source"].includes(mode) ? `overview-${mode}` : undefined;
const topics = [
  { value: "tools", label: "Werkzeuge" },
  { value: "evidence", label: "Belege" },
  { value: "practice", label: "Praxis" },
];
const facetOptions =
  mode === "many"
    ? [
        ...topics,
        ...["Produktmanagement", "Softwarefabriken", "Führung", "Einstieg", "Kontext", "Sicherheit"]
          .concat([
            "Agentische Entwicklung",
            "Qualität",
            "Bücher",
            "Recherche",
            "Organisation und Rollen",
            "Messung",
          ])
          .map((label) => ({ value: label.toLowerCase(), label })),
      ]
    : topics;
const rows = [
  { title: "Context Engineering", topic: "tools", days: "2 Tage", hue: "teal" },
  { title: "Spec-driven Development", topic: "tools", days: "1 Tag", hue: "teal" },
  { title: "Messbare Produktivität", topic: "evidence", days: "1 Tag", hue: "purple" },
  { title: "Agenten im Team", topic: "practice", days: "2 Tage", hue: "amber" },
];
const both = mode === "listed" || mode === "many";
const items = rows.map((r) => ({
  text: r.title.toLowerCase(),
  facets: both ? { topic: [r.topic], days: [r.days[0]!] } : { topic: [r.topic] },
}));
const facets =
  mode === "none"
    ? []
    : [
        { param: "topic", legend: "Thema", options: facetOptions },
        ...(both
          ? [
              {
                param: "days",
                legend: "Dauer",
                options: [
                  { value: "1", label: "1 Tag" },
                  { value: "2", label: "2 Tage" },
                ],
              },
            ]
          : []),
      ];
---

<div class="demo hw-focus-ring" data-hw-scale={scale} data-theme={night ? "dark" : undefined}>
  <ListFilter
    id={`units-${scale}-${night ? "night" : "day"}`}
    action="#"
    label="Einheiten suchen"
    items={items}
    state={{ q: "", facets: Object.fromEntries(facets.map((f) => [f.param, ""])) }}
    facets={facets}
    browse={overview ? "active" : "always"}
    overview={overview}
    source={mode === "source" ? "../dense/" : undefined}
    listed={mode === "listed"}
    inline={mode === "many"}
    count={{ one: "1 Einheit", other: "{shown} von {total} Einheiten" }}
    copy={{
      all: "Alle",
      clear: "Alles zurücksetzen",
      empty: "Nichts passt. Versucht ein kürzeres Wort oder ein anderes Thema.",
      submit: "Suchen",
      filters: "Filter",
    }}
  >
    {mode === "source" ? (
      <div />
    ) : (
      rows.map((r, i) => (
        <ListRow
          stripeColor={`stripe-${r.hue}`}
          data-filter-item
          data-filter-text={items[i]!.text}
          data-filter-facets={JSON.stringify(items[i]!.facets)}
          data-filter-order={i}
          current={i === 0}
        >
          <span slot="lead" data-filter-title>
            {r.title}
          </span>
          <span slot="trail">{r.days}</span>
        </ListRow>
      ))
    )}
  </ListFilter>
  {overview && <p id={overview}>Überblick: vier Einheiten in drei Themen.</p>}
</div>

<style>
  .demo {
    padding: 1.5rem;
    color: var(--color-ink);
    background: var(--color-white);
  }
  .demo[data-theme="dark"] {
    color: var(--color-night-ink);
    background: var(--color-night);
  }
  .demo :global(.stripe-teal) {
    background: var(--color-teal);
  }
  .demo :global(.stripe-purple) {
    background: var(--color-purple);
  }
  .demo :global(.stripe-amber) {
    background: var(--color-amber);
  }
</style>
