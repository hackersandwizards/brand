---
// PageHeader with the slots a list page fills, each passed only when its story asks for it: a
// subtitle with a link, an action.
import PageHeader from "../expert/components/PageHeader.astro";

interface Props {
  title: string;
  subtitleText?: string;
  subtitleSlot?: boolean;
  action?: boolean;
}
const { title, subtitleText, subtitleSlot, action } = Astro.props;
---

<PageHeader title={title} subtitleText={subtitleText}>
  {subtitleSlot && (
    <span slot="subtitle">
      32 units · <a href="#">7 in the standard</a>
    </span>
  )}
  {action && (
    <a slot="action" class="hw-button" data-variant="secondary" href="#">
      All resources
    </a>
  )}
</PageHeader>
