{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "types": ["bun"]
  },
  "include": [
    "scripts/**/*.ts",
    "scan/**/*.ts",
    "test/**/*.ts",
    "applications/**/*.ts",
    "expert/**/*.ts",
    "generated/tokens.ts"
  ]
}
