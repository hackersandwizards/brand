---
// The theme switch: the moon by day, the sun by night, as the switch shows the theme it turns to
// (theme-icons.ts). In the header it is the bar's round icon link (header.css, data-icon).
import { MOON, SUN } from "./theme-icons";
---

<button
  id="theme-toggle"
  class="hw-header-link"
  data-icon
  aria-label="Toggle theme"
  aria-pressed="false"
  type="button"
>
  <svg id="sun-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d={SUN}
    ></path>
  </svg>
  <svg id="moon-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d={MOON}
    ></path>
  </svg>
</button>

<script>
  function initThemeToggle() {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle) return;

    // expert.css picks the icon from data-theme; the script keeps aria-pressed in step.
    function updatePressed() {
      const isDark = document.documentElement.getAttribute("data-theme") === "dark";
      toggle!.setAttribute("aria-pressed", isDark ? "true" : "false");
    }

    updatePressed();

    // After updatePressed: a re-init must refresh the state but not stack listeners.
    if (toggle.dataset.themeInit) return;
    toggle.dataset.themeInit = "1";

    toggle.addEventListener("click", () => {
      const root = document.documentElement;
      const currentTheme = root.getAttribute("data-theme");
      const newTheme = currentTheme === "dark" ? "light" : "dark";
      // Freeze transitions across the flip, or 1k+ of them cascade-fade the page; the
      // first rAF lets styles settle before transitions come back.
      root.classList.add("theme-switching");
      root.setAttribute("data-theme", newTheme);
      // Storage can be blocked (private mode, a file:// page); the flip still holds for this page.
      try {
        localStorage.setItem("theme", newTheme);
      } catch {}
      updatePressed();
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          root.classList.remove("theme-switching");
        });
      });
    });
  }

  initThemeToggle();
</script>
