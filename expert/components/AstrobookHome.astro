---
// The home of every repository's Astrobook (decision design-system-tool, 2026-11-02), in the
// catalogue shape: one tile per story file, grouped by its first folder under the stories
// directory, linking its first state and drawing it at three quarters. Astrobook's `home` is a page
// of the repository's own that passes Astrobook's story modules and global config
// (virtual:astrobook/story-modules.mjs, virtual:astrobook/global-config.mjs) with the words; the
// default slot is the repository's foundations, as on Catalogue.astro.
import Catalogue from "./Catalogue.astro";
import pkg from "../../package.json";

type StoryModule = { name: string; directory?: string; stories: { id: string }[] };

interface Props {
  modules: StoryModule[];
  config: { dashboardBase: string; storyBase: string; trailingSlash?: string };
  product: string;
  title: string;
  lead: string;
  /** Where the system lives, named in the provenance line before the brand version. */
  source: string;
  href?: string;
  /** Draw each tile's first state; off for a system whose states load slowly. */
  previews?: boolean;
}

const { modules, config, product, title, lead, source, href, previews = true } = Astro.props;
const slash = config.trailingSlash === "always" ? "/" : "";
const url = (base: string, id: string) => `${base.replace(/\/$/, "")}/${id}${slash}`;
const groups = new Map<string, { name: string; href: string; pill: string; frame?: string }[]>();
let states = 0;
for (const m of [...modules].sort((a, b) => a.name.localeCompare(b.name))) {
  const first = m.stories[0];
  if (!first) continue;
  states += m.stories.length;
  const group = m.directory?.split("/")[0] || "Components";
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({
    name: m.name,
    href: url(config.dashboardBase, first.id),
    pill: m.stories.length === 1 ? "1 state" : `${m.stories.length} states`,
    frame: previews ? url(config.storyBase, first.id) : undefined,
  });
}
const data = {
  title,
  lead,
  provenance: `${source} · @hackersandwizards/brand v${pkg.version} · ${modules.length} components · ${states} states`,
  groups: [...groups].sort(([a], [b]) => a.localeCompare(b)).map(([name, items]) => ({ name, items })),
};
---

<Catalogue product={product} href={href} {...data}><slot /></Catalogue>
