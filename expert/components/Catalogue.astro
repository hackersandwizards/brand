---
// The catalogue shape on an Astro page: the internal header, then catalogue.ts's rail, title,
// provenance and tile grid. The default slot renders between the provenance line and the first
// group: the system's foundations (tokens, element tiles). The page loads the package's tokens and
// elements.
import AppHeader from "./AppHeader.astro";
import { renderCatalogue, type CatalogueData } from "../catalogue";
import "../header.css";
import "../catalogue.css";

type Props = Omit<CatalogueData, "intro"> & { product: string; href?: string };

const { product, href, ...data } = Astro.props;
const intro = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
---

<AppHeader product={product} href={href}><slot name="nav" /></AppHeader>
<Fragment set:html={renderCatalogue({ ...data, intro })} />
