---
import SpaceNavTree from "./SpaceNavTree.astro";
import type { SpaceNode } from "./space-nav";

interface Props {
  label: string;
  base: string;
  nodes: SpaceNode[];
  currentPath: string;
  pageCount: number;
  /** Links under the tree, set off by a rule: pages outside the space's folders. */
  extra?: Array<{ href: string; label: string }>;
  /** The component's own words, English unless a page in another language passes its own. */
  labels?: {
    sections?: string;
    browse?: string;
    pages?: (count: number) => string;
    home?: string;
    overview?: string;
  };
}

const { label, base, nodes, currentPath, pageCount, extra = [], labels = {} } = Astro.props;
const {
  sections = `${label} sections`,
  browse = `Browse ${label}`,
  pages = (count: number) => `${count} ${count === 1 ? "page" : "pages"}`,
  home = `${label} home`,
  overview,
} = labels;
---

<nav
  aria-label={sections}
  class="hw-nav lg:sticky lg:top-(--nav-offset) lg:max-h-[calc(100vh-var(--nav-offset))] lg:w-60 lg:shrink-0 lg:self-start lg:overflow-y-auto lg:py-6"
>
  <button
    id="space-nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="space-nav-tree"
    class="mt-4 flex w-full items-center justify-between rounded-brand border border-foreground/15 px-3 py-2 text-ui lg:hidden"
  >
    <span class="font-medium">{browse}</span>
    <span class="text-foreground/70">{pages(pageCount)} <span aria-hidden="true">▾</span></span>
  </button>

  <div id="space-nav-tree" class="hidden pt-2 lg:block lg:pt-0">
    <ul class="mb-1">
      <li>
        <a href={base} aria-current={currentPath === base ? "page" : undefined}>{home}</a>
      </li>
    </ul>
    <SpaceNavTree nodes={nodes} currentPath={currentPath} overview={overview} />
    {extra.length > 0 && (
      <ul class="mt-2 border-t border-foreground/15 pt-2">
        {extra.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === currentPath ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</nav>

<script>
  const toggle = document.getElementById("space-nav-toggle");
  const tree = document.getElementById("space-nav-tree");
  toggle?.addEventListener("click", () => {
    const open = tree?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
