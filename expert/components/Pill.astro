---
/**
 * The shared pill (`hw-pill`, elements/pill.css) behind the apps' props, so a caller keeps its
 * colour constants. `color` names a wash (`bg-<hue>/<n>`, else `text-<hue>`): its hue becomes the
 * pill's `--hw-pill-hue`, a grey wash (`bg-muted`, `bg-foreground/<n>`) or none the neutral tone.
 * `priority` is the element's priority scale instead of a colour, `unset` its outline (no value
 * set), and a button with words its editable corner. The element sets the size per scale.
 */
interface Props {
  color?: string;
  icon?: string;
  label?: string;
  title?: string;
  as?: "span" | "button";
  /** No value set: a line on no fill. */
  unset?: boolean;
  /** A priority, 0 to 4 (P0 to P4), in place of `color`. */
  priority?: number;
  class?: string;
  id?: string;
  data?: Record<string, string | number | boolean | undefined>;
  "aria-label"?: string;
  "aria-haspopup"?: "menu" | "dialog" | "true" | "false";
  "aria-expanded"?: "true" | "false";
}

const {
  color,
  icon,
  label,
  title,
  as = "span",
  unset = false,
  priority,
  class: extraClass = "",
  id,
  data,
  "aria-label": ariaLabel,
  "aria-haspopup": ariaHasPopup,
  "aria-expanded": ariaExpanded,
} = Astro.props;

const attrs: Record<string, string> = {};
// One meaning per property: a pill that changes its value here (a button with words) takes the
// editable corner; one only read, and a button holding only an icon, stays round.
if (as === "button" && (label !== undefined || Astro.slots.has("default")))
  attrs["data-editable"] = "";
if (unset) attrs["data-variant"] = "outline";
else if (priority !== undefined) attrs["data-priority"] = String(priority);
else {
  const classes = (color ?? "").split(/\s+/).filter((c) => c && !c.includes(":"));
  const hue = (
    classes.find((c) => c.startsWith("bg-"))?.slice(3) ??
    classes.find((c) => /^text-[a-z]/.test(c))?.slice(5)
  )?.split("/")[0];
  if (!hue || hue === "muted" || hue === "foreground") attrs["data-tone"] = "neutral";
  else {
    // The expert roles (--hue-*, --error, --tier-*) are plain variables that flip with the theme,
    // and Tailwind emits no --color-<role> for them; a brand colour has only --color-<name>.
    const v = `var(--${hue}, var(--color-${hue}))`;
    attrs.style = `--hw-pill-hue: ${v}; --hw-pill-hue-night: ${v}`;
  }
}
const classes = `hw-pill inline-flex items-center gap-1 whitespace-nowrap ${extraClass}`.trim();

const dataAttrs: Record<string, string> = {};
for (const [k, v] of Object.entries(data ?? {}))
  if (v !== undefined) dataAttrs[k.startsWith("data-") ? k : `data-${k}`] = String(v);
---

{as === "button" ? (
  <button
    type="button"
    id={id}
    class={classes}
    title={title}
    aria-label={ariaLabel}
    aria-haspopup={ariaHasPopup}
    aria-expanded={ariaExpanded}
    {...attrs}
    {...dataAttrs}
  >
    {icon && <span aria-hidden="true">{icon}</span>}
    {label && <span>{label}</span>}
    <slot />
  </button>
) : (
  <span
    id={id}
    class={classes}
    title={title}
    aria-label={ariaLabel}
    role={ariaLabel && !label ? "img" : undefined}
    {...attrs}
    {...dataAttrs}
  >
    {icon && <span aria-hidden="true">{icon}</span>}
    {label && <span>{label}</span>}
    <slot />
  </span>
)}
