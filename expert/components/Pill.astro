---
interface Props {
  color?: string;
  icon?: string;
  label?: string;
  title?: string;
  as?: "span" | "button";
  /** No value set: a line in the text colour on no fill; `color` then sets only the text. */
  unset?: boolean;
  size?: "xs" | "sm" | "md";
  class?: string;
  id?: string;
  data?: Record<string, string | number | boolean | undefined>;
  "aria-label"?: string;
  "aria-haspopup"?: "menu" | "dialog" | "true" | "false";
  "aria-expanded"?: "true" | "false";
}

const {
  // The neutral fill. On a card whose surface is the muted fill (the trainer hub in dark) it
  // vanishes, so such an app passes its own color.
  color = "bg-muted text-foreground/70",
  icon,
  label,
  title,
  as = "span",
  unset = false,
  size = "sm",
  class: extraClass = "",
  id,
  data,
  "aria-label": ariaLabel,
  "aria-haspopup": ariaHasPopup,
  "aria-expanded": ariaExpanded,
}: Props = Astro.props;

// min-height + leading-none: emoji glyphs are taller than Latin and would drift the box height.
const sizeClass =
  size === "md"
    ? "px-2.5 py-1 text-ui leading-none min-h-[28px]"
    : size === "xs"
      ? "px-1.5 py-0.5 text-ui leading-none min-h-[20px]"
      : "px-2 py-0.5 text-ui leading-none min-h-[22px]";

// One meaning per property (os decision label-system C, 2026-11-01): a pill that changes its value
// here, a button with words, takes the small corner of a button or field; one only read, and a
// button holding only an icon, stays round. A line means no value set, never emphasis. The
// transparent border reserves the line's width, keeping a mixed row aligned.
const editable = as === "button" && (label !== undefined || Astro.slots.has("default"));
const classes = [
  "inline-flex items-center gap-1 font-medium whitespace-nowrap border",
  editable ? "rounded-sm" : "rounded-full",
  sizeClass,
  color,
  unset ? "border-current/40" : "border-transparent",
  as === "button" ? "cursor-pointer select-none transition-colors" : "",
  extraClass,
]
  .filter(Boolean)
  .join(" ");

const dataAttrs: Record<string, string> = {};
if (data) {
  for (const [k, v] of Object.entries(data)) {
    if (v === undefined) continue;
    const key = k.startsWith("data-") ? k : `data-${k}`;
    dataAttrs[key] = String(v);
  }
}
---

{as === "button" ? (
  <button
    type="button"
    id={id}
    class={classes}
    title={title}
    aria-label={ariaLabel}
    aria-haspopup={ariaHasPopup}
    aria-expanded={ariaExpanded}
    {...dataAttrs}
  >
    {icon && <span aria-hidden="true">{icon}</span>}
    {label && <span>{label}</span>}
    <slot />
  </button>
) : (
  <span
    id={id}
    class={classes}
    title={title}
    aria-label={ariaLabel}
    role={ariaLabel && !label ? "img" : undefined}
    {...dataAttrs}
  >
    {icon && <span aria-hidden="true">{icon}</span>}
    {label && <span>{label}</span>}
    <slot />
  </span>
)}
