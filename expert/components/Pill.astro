---
/**
 * The shared pill (`hw-pill`, elements/pill.css) behind the apps' props, so a caller keeps its
 * colour constants. `color` names a wash (`bg-<hue>/<n>`, else `text-<hue>`): its hue becomes the
 * pill's `--hw-pill-hue`, a grey wash (`bg-muted`, `bg-foreground/<n>`) or none the neutral tone.
 * `priority` is the element's priority scale instead of a colour, `unset` its outline (no value
 * set), and a button with words its editable corner. The element sets the size per scale.
 */
interface Props {
  color?: string;
  icon?: string;
  label?: string;
  title?: string;
  as?: "span" | "button";
  /** No value set: a line on no fill. */
  unset?: boolean;
  /** A priority, 0 to 4 (P0 to P4), in place of `color`. */
  priority?: number;
  class?: string;
  id?: string;
  data?: Record<string, string | number | boolean | undefined>;
  "aria-label"?: string;
  "aria-haspopup"?: "menu" | "dialog" | "true" | "false";
  "aria-expanded"?: "true" | "false";
}

const {
  color,
  icon,
  label,
  title,
  as = "span",
  unset = false,
  priority,
  class: extraClass = "",
  id,
  data,
  "aria-label": ariaLabel,
  "aria-haspopup": ariaHasPopup,
  "aria-expanded": ariaExpanded,
} = Astro.props;

const attrs: Record<string, string> = {};
for (const [k, v] of Object.entries(data ?? {}))
  if (v !== undefined) attrs[k.startsWith("data-") ? k : `data-${k}`] = String(v);
// One meaning per property: a pill that changes its value here (a button with words) takes the
// editable corner; one only read, and a button holding only an icon, stays round.
if (as === "button" && (label !== undefined || Astro.slots.has("default")))
  attrs["data-editable"] = "";
if (unset) attrs["data-variant"] = "outline";
else if (priority !== undefined) attrs["data-priority"] = String(priority);
else {
  // A text-* utility that sets size, alignment or wrapping names no hue.
  const NOT_HUE = /^(xs|sm|base|lg|\d?xl|ui|meta|micro|page|heading|subheading|left|right|center|justify|start|end|wrap|nowrap|balance|pretty|ellipsis|clip)$/;
  const words = (color ?? "").split(/\s+/).filter((c) => c && !c.includes(":") && !c.includes("["));
  const named = (prefix: string) =>
    words
      .filter((c) => c.startsWith(prefix))
      .map((c) => c.slice(prefix.length).split("/")[0]!)
      .find((h) => !NOT_HUE.test(h));
  const hue = named("bg-") ?? named("text-");
  if (!hue || hue === "muted" || hue === "foreground") attrs["data-tone"] = "neutral";
  else {
    // The expert roles (--hue-*, --error, --tier-*) are plain variables that flip with the theme,
    // and Tailwind emits no --color-<role> for them; a brand colour has --color-<name> and its
    // night tone --color-<name>-night, or for ampersand and factory their light tone (the hue
    // table in tokens.css).
    const night = `${hue}-${hue === "ampersand" || hue === "factory" ? "light" : "night"}`;
    attrs.style = `--hw-pill-hue: var(--${hue}, var(--color-${hue})); --hw-pill-hue-night: var(--${hue}, var(--color-${night}, var(--color-${hue})))`;
  }
}
const classes = `hw-pill whitespace-nowrap ${extraClass}`.trim();
---

{as === "button" ? (
  <button
    type="button"
    id={id}
    class={classes}
    title={title}
    aria-label={ariaLabel}
    aria-haspopup={ariaHasPopup}
    aria-expanded={ariaExpanded}
    {...attrs}
  >
    {icon && <span class="hw-pill-icon" aria-hidden="true">{icon}</span>}
    {label && <span>{label}</span>}
    <slot />
  </button>
) : (
  <span
    id={id}
    class={classes}
    title={title}
    aria-label={ariaLabel}
    role={ariaLabel && !label ? "img" : undefined}
    {...attrs}
  >
    {icon && <span class="hw-pill-icon" aria-hidden="true">{icon}</span>}
    {label && <span>{label}</span>}
    <slot />
  </span>
)}
