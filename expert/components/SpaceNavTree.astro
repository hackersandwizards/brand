---
/** A space's tree on hw-nav (elements/nav.css): a page is a link, a folder a disclosure open while
 *  it holds the current page, its own page first as `overview`. Render it inside a <nav class="hw-nav">. */
import { containsPath, type SpaceNode } from "./space-nav";

interface Props {
  nodes: SpaceNode[];
  currentPath: string;
  /** The link to a branch's own page. */
  overview?: string;
  /** Only the items, for the list a branch already opened. */
  bare?: boolean;
}

const { nodes, currentPath, overview = "Overview", bare = false } = Astro.props;
const current = (href: string) => (href === currentPath ? "page" : undefined);
const Wrap = bare ? Fragment : "ul";
---

<Wrap>
  {nodes.map((node) =>
    node.children.length === 0 ? (
      <li>
        <a href={node.href} aria-current={current(node.href)}>
          {node.label}
        </a>
      </li>
    ) : (
      <li>
        <details class="hw-disclosure" open={containsPath(node, currentPath)}>
          <summary>{node.label}</summary>
          <ul>
            {node.hasPage && (
              <li>
                <a href={node.href} aria-current={current(node.href)}>
                  {overview}
                </a>
              </li>
            )}
            <Astro.self nodes={node.children} currentPath={currentPath} overview={overview} bare />
          </ul>
        </details>
      </li>
    ),
  )}
</Wrap>
