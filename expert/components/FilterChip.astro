---
/** An applied filter value: the shared pill (`hw-pill`) with its remove link (`hw-pill-remove`). */
interface Props {
  label?: string;
  removeHref: string;
}

const { label, removeHref } = Astro.props;
---

<span class="hw-pill">
  {label ?? <slot />}
  <a href={removeHref} class="hw-pill-remove" aria-label={label ? `Clear filter ${label}` : "Clear filter"}></a>
</span>
