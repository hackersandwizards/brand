---
/** Search and any number of facets, each as choices or a select, over a list the page
 *  renders in full in the default slot: a GET form to its own page, so the server applies the
 *  URL's state and a shared link and a browser without JavaScript show the same rows: each row
 *  sets `hidden` where `matches(item, state)` is false. The browser side and the rows' attributes
 *  are elements/list-filter.ts's; the look is the shared elements
 *  (hw-search, hw-choice, hw-field, hw-button) placed by elements/list-filter.css, sized by the
 *  page's data-hw-scale. Each facet shows as choices, "All" first, unless its labels run past
 *  `budget` characters, then as a select; no facet shows the search alone, without Filters button.
 *  On a phone the facets fold behind that button, which names the chosen values, and a tapped
 *  choice folds them again. Ctrl+K or Cmd+K focuses the search.
 *  `browse="active"` shows the list only while a filter is set, in place of the element `overview`
 *  names. Under it a static page keeps its rows out of the page without JavaScript: in an inert
 *  template, the form showing only once the script runs; `source` names a page listing every row,
 *  where the form sends its query and whose rows load on first use; `listed` keeps them in the page
 *  instead. Copy is a prop, so a page in another language passes its own. */
import {
  countLine,
  filtersLabel,
  fullTextUrl,
  isActive,
  matches,
  tally,
  type CountCopy,
  type FilterItem,
  type FilterState,
} from "../../elements/list-filter";

interface Option {
  value: string;
  label: string;
}

interface Facet {
  param: string;
  legend: string;
  options: Option[];
}

interface Props {
  id: string;
  /** The page itself, where the form sends its query. */
  action: string;
  /** The search field's accessible name and placeholder. */
  label: string;
  items: FilterItem[];
  state: FilterState;
  /** In order: each as choices, or as a select past `budget`. Pass only facets that split the rows. */
  facets: Facet[];
  /** The summed label length of one facet, "All" included, past which it shows as a select. */
  budget?: number;
  /** The count line, with {shown} and {total}, or one for a single match and one for any other. */
  count: CountCopy;
  /** "always" (default) lists every row until a filter narrows them; "active" only while one is set. */
  browse?: "always" | "active";
  /** The id of the page's overview, hidden while a filter is set. */
  overview?: string;
  /** A fuller search the query can continue in; `?q=` is appended. */
  fullText?: { href: string; label: string };
  /** A page listing every row, for `browse="active"`: the form's target, and the rows' source. */
  source?: string;
  /** Under `browse="active"`, the rows stay in the page without JavaScript. */
  listed?: boolean;
  /** From 64rem, the first select sits beside the search. */
  inline?: boolean;
  copy?: { all: string; clear: string; empty: string; submit: string; filters: string };
}

const {
  id,
  action,
  label,
  items,
  state,
  facets,
  count,
  browse = "always",
  overview,
  fullText,
  source,
  listed: keep = false,
  inline = false,
  budget = 160,
  copy = {
    all: "All",
    clear: "Clear all",
    empty: "Nothing matches. Try a shorter word or another topic.",
    submit: "Search",
    filters: "Filters",
  },
} = Astro.props;

const active = isActive(state);
const listed = browse === "always" || active || keep;
// Under an overview with nowhere else to send the query, the rows wait in a template.
const inert = browse === "active" && !source && !keep && !active;
const asChoices = (facet: Facet) =>
  [copy.all, ...facet.options.map((option) => option.label)].join("").length <= budget;
const shown = items.filter((item) => matches(item, state)).length;
const countText = listed ? countLine(count, shown, items.length) : "";

const faceted = Object.values(state.facets).some(Boolean);
// The phone's Filters button names what is picked, since its panel closes over it.
const filtersButton = filtersLabel(
  copy.filters,
  facets.map(
    (facet) => facet.options.find((option) => option.value === state.facets[facet.param])?.label,
  ),
);
---

<div
  class="hw-list-filter"
  data-list-filter={browse}
  data-count={JSON.stringify(count)}
  data-overview={overview}
  data-source={source}
  data-listed={keep && browse === "active" ? "" : undefined}
  data-inline={inline ? "" : undefined}
>
  <form role="search" action={source ?? action} hidden={inert}>
    <div class="hw-list-filter-search">
      <div class="hw-search">
        <input
          id={id}
          class="hw-field"
          type="search"
          name="q"
          value={state.q}
          placeholder={label}
          aria-label={label}
          aria-keyshortcuts="Control+K Meta+K"
          autocomplete="off"
          enterkeyhint="search"
        />
      </div>
      <button type="submit" class="hw-button" data-variant="secondary" data-filter-submit>
        {copy.submit}
      </button>
      {facets.length > 0 && (
        <button
          type="button"
          class="hw-button"
          data-variant={faceted ? undefined : "secondary"}
          aria-expanded="false"
          aria-controls={`${id}-facets`}
          aria-label={filtersButton.aria}
          data-filter-toggle
          data-filters={copy.filters}
        >
          <span data-filter-label>{filtersButton.text}</span>
        </button>
      )}
    </div>
    <div id={`${id}-facets`} data-filter-panel hidden={facets.length === 0}>
      {facets.map((facet) => {
        const counts = tally(items, state, facet.param);
        const options = [{ value: "", label: copy.all }, ...facet.options];
        const chosen = state.facets[facet.param] ?? "";
        return asChoices(facet) ? (
          <fieldset class="hw-form-field">
            <legend class="hw-form-label">{facet.legend}</legend>
            <div class="hw-choices">
              {options.map((option) => (
                <label class="hw-choice">
                  <input
                    type="radio"
                    name={facet.param}
                    value={option.value}
                    checked={chosen === option.value}
                    data-label={option.label}
                  />
                  {option.label}
                  <span class="hw-choice-count" data-facet-count={option.value}>
                    {counts.get(option.value) ?? 0}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        ) : (
          <label class="hw-form-field">
            <span class="hw-form-label">{facet.legend}</span>
            <select name={facet.param} class="hw-field hw-select">
              {options.map((option) => (
                <option
                  value={option.value}
                  selected={chosen === option.value}
                  data-label={option.label}
                >
                  {`${option.label} (${counts.get(option.value) ?? 0})`}
                </option>
              ))}
            </select>
          </label>
        );
      })}
    </div>
    <p class="hw-list-filter-status">
      <span aria-live="polite" data-filter-count>{countText}</span>
      <a href={action} class="hw-link" data-filter-clear hidden={!active || shown === 0}>
        {copy.clear}
      </a>
      {fullText && (
        <a
          href={fullTextUrl(fullText.href, state.q)}
          class="hw-link"
          data-filter-fulltext={fullText.href}
          hidden={!state.q}
        >
          {fullText.label}
        </a>
      )}
    </p>
  </form>
  <div data-filter-list hidden={!listed || shown === 0}>
    {
      inert ? (
        <template data-filter-rows>
          <slot />
        </template>
      ) : (
        <slot />
      )
    }
  </div>
  <div data-filter-empty hidden={!listed || shown > 0}>
    <p>{copy.empty}</p>
    <a href={action} class="hw-link" data-filter-clear>{copy.clear}</a>
  </div>
</div>
{
  /* Before first paint: the phone's facets start closed, the form shows, and under an overview the
   listed rows and their count line wait for a filter. Should the module never mark the filter ready, the page returns
   to its state without script, so the facets and the search button stay usable. */
}
<script is:inline>
  {
    const root = document.currentScript.previousElementSibling;
    const form = root.querySelector("form");
    const list = root.querySelector("[data-filter-list]");
    const count = root.querySelector("[data-filter-count]");
    const overview = root.dataset.overview && document.getElementById(root.dataset.overview);
    const was = [form.hidden, list.hidden, overview && overview.hidden, count.textContent];
    const params = new URLSearchParams(location.search);
    const set = [...form.querySelectorAll("[name]")].some((field) => params.get(field.name));
    root.dataset.js = "";
    root.dataset.closed = "";
    form.hidden = false;
    if ("listed" in root.dataset && !set) {
      list.hidden = true;
      count.textContent = "";
    }
    if (set && overview) overview.hidden = true;
    addEventListener("DOMContentLoaded", () => {
      if ("ready" in root.dataset) return;
      delete root.dataset.js;
      delete root.dataset.closed;
      [form.hidden, list.hidden, , count.textContent] = was;
      if (overview) overview.hidden = was[2];
    });
  }
</script>

<script>
  import { initListFilter } from "../../elements/list-filter";

  for (const root of document.querySelectorAll<HTMLElement>("[data-list-filter]"))
    initListFilter(root);
</script>
